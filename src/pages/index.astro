---
import { getCollection, getEntries, getEntry } from 'astro:content';
import Contact from '../components/Contact.astro';
import ExpCard from '../components/ExpCard.astro';
import IndexProjectCard from '../components/IndexProjectCard.astro';
import Layout from '../layouts/Layout.astro';

const about = await getEntry('about', 'about')!;
const featuredIds = about.data.featuredprojects;
const featured = featuredIds ? await getEntries(featuredIds.map(id => ({ collection: 'projects', id }))) : null;

const experiences = await getCollection('experiences');
const sortedexp = experiences.sort((a, b) => {
	// Sorts these in LinkedIn style order
	
    const parseStrictDate = (dateValue: string | undefined, fileId: string) => {
        if (!dateValue || dateValue.toLowerCase() === 'present') {
            return new Date().getTime();
		}

		const dateRegex = /^(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)\s\d{4}$/i;
        if (!dateRegex.test(dateValue.trim())) {
            throw new Error(`Malformed or invalid month name string "${dateValue}" found in experience: "${fileId}"`);
        }

		return new Date(dateValue).getTime();
    };

    const endA = parseStrictDate(a.data.end, a.id);
    const endB = parseStrictDate(b.data.end, b.id);

    if (endB !== endA) {
        return endB - endA;
    }

    return parseStrictDate(b.data.start, b.data.title) - parseStrictDate(a.data.start, a.data.title);
});
---

<Layout title="Vidyut Venkatesan">
	<h1 class="index-title">{about.data.indexmessage}</h1>
	<Contact email={about.data.email} github={about.data.github} linkedin={about.data.linkedin} />
	
	<section class="page-section">
		<h2 class="section-label">Featured Projects</h2>
		<div class="section-container">
			{featured && featured.map(f => 
				<IndexProjectCard
					href={f.data.featured ? `/projects/${f.id}` : f.data.repo}
                	external={!f.data.featured}
					title={f.data.title}
					summary={f.data.summary} 
				/>
			)}
		</div>
	</section>

	<section class="page-section">
		<h2 class="section-label">Experience</h2>
		<div class="section-container">
			{sortedexp && sortedexp.map(e =>
				<ExpCard
					title={e.data.title}
					company={e.data.company}
					location={e.data.location}
					summary={e.data.summary}
					start={e.data.start}
					end={e.data.end}
				/>
			)}
		</div>
	</section>
</Layout>

<style>
	.index-title {
		margin-bottom: 2.5rem;
		font-size: 1.5rem;
		font-family: var(--font-sans);
		font-weight: 500;
		line-height: 1.4;
		max-width: 40ch;
	}

	.page-section {
		margin-top: 4rem;
	}

	.section-container {
		display: flex;
		flex-direction: column;
		gap: 35px;
	}

	.section-label {
		font-family: var(--font-mono);
		font-size: 1.25rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-text);
		margin: 0 0 2rem;
	}
</style>
