---
import Contact from '../components/Contact.astro';
import ExpCard from '../components/ExpCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout title="Vidyut Venkatesan">
	<h1 class="index-title">
		Software engineer in Melbourne, working on backend systems and distributed infrastructure.
	</h1>
	<Contact />
	
	<section class="page-section">
		<h2 class="section-label">Featured Projects</h2>
		<div class="section-container">
			<ProjectCard />
			<ProjectCard />
		</div>
	</section>

	<section class="page-section">
		<h2 class="section-label">Experience</h2>
		<div class="section-container">
			<ExpCard />
			<ExpCard />
		</div>
	</section>
</Layout>

<style>
	.index-title {
		margin-bottom: 2.5rem;
		font-size: 1.5rem;
		font-family: var(--font-sans);
		font-weight: 500;
		line-height: 1.4;
		max-width: 40ch;
	}

	.page-section {
		margin-top: 4rem;
	}

	.section-container {
		display: flex;
		flex-direction: column;
		gap: 35px;
	}

	.section-label {
		font-family: var(--font-mono);
		font-size: 1.25rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--color-text);
		margin: 0 0 2rem;
	}
</style>
