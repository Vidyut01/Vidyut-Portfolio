---
interface Props {
    title: string;
    company: string;
    location?: string;
    start: string;
    end?: string;
    summary: string;
};

const { title, company, location, start, end, summary } = Astro.props;
---
<div class="exp-card">
    <div class="exp-header">
        <h3 class="exp-title">{title}</h3>
        <span class="exp-date">{start.toLowerCase()} &ndash; {end?.toLowerCase() || 'present'}</span>
    </div>
    <p class="exp-company">{`${company}${location ? ', ' + location : ''}`}</p>
    <p class="exp-content">{summary}</p>
</div>

<style>
    .exp-header {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
    }
    .exp-title {
        margin: 0;
        font-size: 1.4rem;
        font-weight: 500;
    }
    .exp-company {
        margin: 0;
        color: var(--color-text-muted);
        font-size: 1.05rem;
        font-family: var(--font-mono);
    }
    .exp-date {
        color: var(--color-text-muted);
        font-family: var(--font-mono);
    }

    .exp-content {
        font-size: 0.95rem;
        line-height: 1.6;
        max-width: 60ch;
    }
</style>