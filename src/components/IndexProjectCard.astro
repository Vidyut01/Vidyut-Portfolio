---
interface Props {
    title: string;
    summary: string;
    id: string;
};

const { title, summary, id } = Astro.props;
---
<a href={`/projects/${id}`} class="index-project-card">
    <h3 class="index-project-title">{title} <span class="arrow">→</span></h3>
    <p class="index-project-info">{summary}</p>
</a>

<style>
    .index-project-card {
        width: fit-content;
        display: block;
        color: var(--color-text);
        padding: 0.5rem 0 0.5rem 1rem;
        margin-left: -1rem;
        border-left: 2px solid transparent;
        transition: border-color 0.3s ease-in-out;
    }

    .index-project-card:hover,
    .index-project-card:focus-visible {
        border-left-color: var(--color-accent);
    }

    .index-project-card:hover .index-project-title,
    .index-project-card:focus-visible .index-project-title {
        color: var(--color-accent);
    }

    .index-project-title {
        font-size: 1.4rem;
        font-weight: 500;
        margin: 0 0 0.4rem;
        transition: color 0.3s ease-in-out;
    }

    .index-project-info {
        font-size: 1.1rem;
        color: var(--color-text-muted);
        margin: 0;
    }

    .arrow {
        color: var(--color-accent);
        transition: transform 0.2s ease;
        display: inline-block;
    }
    .index-project-card:hover .arrow {
        transform: translateX(3px);
    }
</style>
