---
interface Props {
    title: string;
    summary: string;
    href?: string;
    external?: boolean;
};

const { title, summary, href, external } = Astro.props;
---
{href && <a href={href} target={external ? '_blank' : '_self'} rel={external ? 'noopener noreferrer' : undefined} class="index-project-card">
    <h3 class="index-project-title">{title}&nbsp;{external ? <span class="ext-arrow">&nearrow;</span> : <span class="arrow">→</span>}</h3>
    <p class="index-project-info">{summary}</p>
</a>}

{!href && <div class="index-project-card">
    <h3 class="index-project-title">{title}</span></h3>
    <p class="index-project-info">{summary}</p>
</div>}

<style>
    .index-project-card {
        width: fit-content;
        display: block;
        color: var(--color-text);
        padding: 0.5rem 0 0.5rem 1rem;
        margin-left: -1rem;
        border-left: 2px solid transparent;
        transition: border-color 0.3s ease-in-out;
    }

    .index-project-card:hover,
    .index-project-card:focus-visible {
        border-left-color: var(--color-accent);
    }

    .index-project-card:hover .index-project-title,
    .index-project-card:focus-visible .index-project-title {
        color: var(--color-accent);
    }

    .index-project-title {
        font-size: 1.4rem;
        font-weight: 500;
        margin: 0 0 0.4rem;
        transition: color 0.3s ease-in-out;
    }

    .index-project-info {
        font-size: 1.1rem;
        color: var(--color-text-muted);
        margin: 0;
    }

    .arrow {
        color: var(--color-accent);
        transition: transform 0.2s ease;
        display: inline-block;
    }

    .ext-arrow {
        color: var(--color-accent);
        font-size: 1em;
        display: inline-block;
        transition: transform 0.2s ease;
    }
    .index-project-card:hover .arrow {
        transform: translateX(3px);
    }

    .index-project-card:hover .ext-arrow {
        transform: translate(3px, -3px);
    }
</style>
