---
interface Props {
    title: string;
    summary: string;
    tech?: string[];
    id: string;
};

const { title, summary, tech, id } = Astro.props;
---

<a href={`/projects/${id}`} class="project-card">
    <h3 class="project-title">{title} <span class="arrow">&rarr;</span></h3>
    <p class="project-info">{summary}</p>
    { tech && <ul class="project-stack-list">
        {tech.map(t => <li>{t}</li>)}
    </ul>}
</a>

<style>
    .project-card {
        width: fit-100%;
        display: block;
        color: var(--color-text);
        padding: 0.5rem 0 0.5rem 1rem;
        margin-left: -1rem;
        border-left: 2px solid transparent;
        transition: border-color 0.3s ease-in-out;
    }

    .project-card:hover,
    .project-card:focus-visible {
        border-left-color: var(--color-accent);
    }

    .project-card:hover .project-title,
    .project-card:focus-visible .project-title {
        color: var(--color-accent);
    }

    .project-title {
        font-size: 1.4rem;
        font-weight: 500;
        margin: 0 0 0.75rem;
        transition: color 0.3s ease-in-out;
    }

    .project-info {
        font-size: 1.1rem;
        margin: 0;
    }

    .arrow {
        color: var(--color-accent);
        transition: transform 0.2s ease;
        display: inline-block;
    }
    .project-card:hover .arrow {
        transform: translateX(3px);
    }

    .project-stack-list {
        list-style: none;
        display: flex;
        padding: 0;
        margin: 0.5rem 0 0 0;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem 1.25rem;
        font-size: 1rem;
    }

    .project-stack-list li {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--color-text-dim);
    }

    .project-stack-list li:not(:last-child)::after {
        content: "·";
        color: var(--color-text-dim);
        margin-left: 1rem;
    }

</style>
